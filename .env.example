# Database (Prisma / SQLite)
DATABASE_URL="file:./dev.db"

# Auth Secret (Auth.js v5) — generate with: openssl rand -base64 32
AUTH_SECRET=

# Planning Center staff sign-in (OpenID Connect). These are intentionally
# separate from the Personal Access Token used for calendar imports below.
# Create an OAuth application at:
# https://api.planningcenteronline.com/oauth/applications
#
# Register this callback for each app origin staff will actually use:
#   http://localhost:3000/api/auth/callback/planning-center
#   http://YOUR-MAC-LAN-IP:3000/api/auth/callback/planning-center
# For an internet-facing installation, use one HTTPS subdomain callback instead.
PLANNING_CENTER_OAUTH_CLIENT_ID=
PLANNING_CENTER_OAUTH_CLIENT_SECRET=
# The numeric organization_id in Planning Center's OIDC identity claims. This
# is required: it prevents a PCO user from another church from signing in.
PLANNING_CENTER_OAUTH_ORGANIZATION_ID=

# Base URL of this app — used for status-page links in emails. Point your cron
# job at this host too (e.g. http://localhost:3000).
APP_URL=http://localhost:3000

# Optional email notifications. My Requests is the canonical receipt/tracker;
# when SMTP is absent, staff still see every update after signing in.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional off-box backups. scripts/backup-db.sh copies successful snapshots to
# this rclone destination when set, e.g. gdrive:church-comms-backups.
BACKUP_REMOTE=

# Optional trusted-machine updater. Leave disabled for public demos, laptops,
# and any internet-exposed install. When enabled, admins can check GitHub and
# run the production update flow from Settings > Updates.
ENABLE_APP_UPDATER=false
UPDATE_REMOTE=origin
UPDATE_BRANCH=main
PM2_APP_NAME=comms
# Optional custom restart command. If blank, the updater tries `pm2 restart
# $PM2_APP_NAME`; if pm2 is unavailable, it tells you to restart manually.
UPDATE_RESTART_CMD=

# ──────────────────────────────────────────────────────────────────────────
# Planning Center API (read-only Calendar import)
# ──────────────────────────────────────────────────────────────────────────
# Model A pulls APPROVED Calendar events (with their booked rooms) down from
# Planning Center. We never write back to PCO.
#
# Preferred: use a Planning Center Personal Access Token pair. Create one in
# the PCO developer console
# (https://api.planningcenteronline.com/oauth/applications) under
# "Personal Access Tokens".
PLANNING_CENTER_APP_ID=
PLANNING_CENTER_SECRET=

# Alternative 1: this app's own HTTP Basic Personal Access Token pair.
# PCO_APP_ID=
# PCO_SECRET=

# Alternative 2: an OAuth bearer token.
# PCO_TOKEN=

# Shared secret guarding the scheduled sync endpoint (GET/POST
# /api/cron/sync-events). Generate with: openssl rand -base64 32
# The cron job must present it as `Authorization: Bearer <CRON_SECRET>` (or
# ?key=<CRON_SECRET>). If unset, the endpoint rejects every request (401).
CRON_SECRET=

# Optional Google/iCal import preview. GOOGLE_EVENTS_CALENDAR_URL can be a human
# calendar page; GOOGLE_EVENTS_ICAL_URL should be an ICS feed. ICAL_IMPORT_FILE
# points the admin-only local iCal importer at a file on disk.
GOOGLE_EVENTS_CALENDAR_URL=
GOOGLE_EVENTS_ICAL_URL=
ICAL_IMPORT_FILE=
